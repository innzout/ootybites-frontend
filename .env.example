# ---- Ootybites frontend env ----
# Only NEXT_PUBLIC_* values reach the browser. No secrets here.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Canonical site origin (no trailing slash) — used for <link rel=canonical>,
# OpenGraph URLs and the sitemap/robots. Set to the real domain in production.
NEXT_PUBLIC_SITE_URL=https://ootybites.com
# Google Maps browser key — powers the checkout/address pin picker AND the
# admin/dealer order-location map. When unset, the picker degrades to manual
# address entry and the admin map falls back to an "Open in Google Maps" link.
# Enable these FOUR APIs on the Google Cloud project:
#   1. Maps JavaScript API   - renders the map
#   2. Geocoding API         - reverse-geocodes a dropped pin into city/pincode
#   3. Places API (NEW)      - address search box. NOT the legacy "Places API":
#                              projects created recently cannot enable it, and
#                              the legacy widget then returns nothing silently.
#   4. Maps Embed API        - admin/dealer order-location map
# Billing must be on, or every call fails with BillingNotEnabledMapError.
# Restrict the key: Application restrictions -> HTTP referrers, listing
# http://localhost:3000/* and your production domain. A referrer-restricted key
# used from any other origin fails with RefererNotAllowedMapError.
# The key must belong to THIS project's own Google Cloud project — do not reuse
# a key from another INNZOUT product, or its quota and referrer rules apply here.
GOOGLE_MAPS_API_KEY=

# Deliberately NOT NEXT_PUBLIC_. The key is read server-side in app/layout.tsx
# and handed to the client via components/shop/MapsConfig. It still reaches the
# browser — a Maps JavaScript key always must — but it is no longer inlined into
# the JS bundle at build time, so rotating it is a restart, not a rebuild.
# Secrecy is not the protection here; the HTTP-referrer and API restrictions on
# the key in Google Cloud are.
#
# Optional. A real Map ID for AdvancedMarkerElement; DEMO_MAP_ID is used when
# unset, which is Google's development default and should not ship to customers.
GOOGLE_MAPS_MAP_ID=
